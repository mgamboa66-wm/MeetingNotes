    "hono": "^4.13.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
